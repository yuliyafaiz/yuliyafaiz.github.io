          "tooltip": null
        },
        {
          "name": "hash_models",
          "type": "BOOLEAN",
          "tooltip": "SHA-256 model files (first run per model can take a while)"
        },
        {
          "name": "notes",
          "type": "STRING",
          "tooltip": null
        }
      ],
      "optional_inputs": [
        {
          "name": "project",
          "type": "CS_PROJECT",
          "tooltip": null
        },
        {
          "name": "profile",
          "type": "CS_PROFILE",
          "tooltip": null
        },
        {
          "name": "variant",
          "type": "CS_VARIANT",
          "tooltip": null
        },
        {
          "name": "references",
          "type": "CS_REFERENCES",
          "tooltip": null
        },
        {
          "name": "positive",
          "type": "STRING",
          "tooltip": null
        },
        {
          "name": "negative",
          "type": "STRING",
          "tooltip": null
        },
        {
          "name": "seed",
          "type": "INT",
          "tooltip": null
        }
      ],
      "outputs": [],
      "output_node": true
    },
    {
      "name": "CS_BatchVariantManager",
      "display_name": "Batch Variant Manager (Creative Studio)",
      "category": "Creative Studio",
      "description": "Structured, reproducible batch variations (text + seed) with metadata.",
      "inputs": [
        {
          "name": "variants",
          "type": "STRING",
          "tooltip": null
        },
        {
          "name": "variant_index",
          "type": "INT",
          "tooltip": null
        },
        {
          "name": "base_seed",
          "type": "INT",
          "tooltip": null
        },
        {
          "name": "seed_strategy",
          "type": "COMBO",
          "options": [
            "increment",
            "hash",
            "fixed"
          ],
          "tooltip": null
        }
      ],
      "optional_inputs": [],
      "outputs": [
        {
          "name": "seed",
          "type": "INT"
        },
        {
          "name": "variant_text",
          "type": "STRING"
        },
        {
          "name": "label",
          "type": "STRING"
        },
        {
          "name": "variant",
          "type": "CS_VARIANT"
        }
      ],
      "output_node": false
    },
    {
      "name": "CS_ProjectMetadata",
      "display_name": "Project Metadata (Creative Studio)",
      "category": "Creative Studio",
      "description": "Project/campaign identifiers for metadata and output folder organisation.",
      "inputs": [
        {
          "name": "project_id",
          "type": "STRING",
          "tooltip": null
        },
        {
          "name": "project_name",
          "type": "STRING",
          "tooltip": null
        },
        {
          "name": "campaign",
          "type": "STRING",
          "tooltip": null
        },
        {
          "name": "job_id",
          "type": "STRING",
          "tooltip": null
        },
        {
          "name": "tags",
          "type": "STRING",
          "tooltip": "comma separated"
        }
      ],
      "optional_inputs": [],
      "outputs": [
        {
          "name": "project",
          "type": "CS_PROJECT"
        },
        {
          "name": "filename_prefix",
          "type": "STRING"
