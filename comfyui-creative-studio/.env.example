# Copy to .env and adjust. All paths are relative to the repository root unless absolute.
CS_COMFY_URL=http://127.0.0.1:8188
CS_DATA_DIR=./data
CS_HOST=127.0.0.1
CS_PORT=8420
# Comma-separated list of allowed browser origins for the Vite dev server.
CS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Seconds between /history polls for active jobs.
CS_POLL_INTERVAL=1.5
# A queued prompt missing from both /queue and /history for this long is marked "lost".
CS_LOST_JOB_GRACE=20
